      "regex": "^/api/admin/members/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmemberId": "nxtPmemberId"
      },
      "namedRegex": "^/api/admin/members/(?<nxtPmemberId>[^/]+?)(?:/)?$"
    },
    {
